# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=course_enrollment
DB_USER=postgres
DB_PASSWORD=password

# ── Salesforce email integration ──
# Templates: OAuth client-credentials against tatti.my.salesforce.com, then a
# SOQL query on EmailTemplate. Send: the public lead-event apexrest with
# emailTemplateId. The client-credentials Run-As user MUST be salesforce@tatti.com
# (full user) or EmailTemplate queries return INVALID_TYPE.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://tatti.my.salesforce.com
SALESFORCE_API_VERSION=v67.0
# SALESFORCE_LEAD_EVENT_URL=https://tatti.my.salesforce-sites.com/TattiCrm/services/apexrest/lead-event
# SALESFORCE_EMAIL_TEMPLATE_FIELD=emailTemplateId
